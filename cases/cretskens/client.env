# =============================================================================
# Case: cretskens
# =============================================================================
ACTIVE_CLIENT_ID=cretskens
ACTIVE_CLIENT_DISPLAY_NAME=GROEP CRETSKENS
ACTIVE_CLIENT_COLLECTION_ID=cretskens
ACTIVE_CLIENT_PRIMARY_COLOR=#6A1E2C
ACTIVE_CLIENT_LOGO_URL=/branding/cretskens/logo.png
ACTIVE_CLIENT_SECONDARY_LOGO_URL=/branding/cretskens/secondary_logo.svg
ACTIVE_CLIENT_LOGO_NO_TEXT_URL=/branding/cretskens/logo_no_text.png
ACTIVE_CLIENT_BACKGROUND_IMAGE_URL=/branding/cretskens/background.png
ACTIVE_CLIENT_WELCOME_MESSAGE="Hallo, ik ben Rob, je AI-assistent. Ik help je graag om de juiste wijn bij je gerecht te vinden. Vertel me wat je gaat eten, dan maak ik een duidelijke samenvatting voor gericht advies in de winkel."
ACTIVE_CLIENT_CHAT_HEADER_TITLE=Groep Cretskens Wijnassistent
KIOSK_DISCLAIMER_TEXT="Alcohol schaadt de gezondheid."
# Temporary hotfix (2026-04-29): disable only the kiosk screensaver trigger in store.
KIOSK_SCREENSAVER_DELAY_MS=2147483647

# Backendprofiel/stack die Pixie moet aanspreken (bijv. informer, recommender, questioner).
PIXIE_BACKEND_TARGET=questioner
PIXIE_QUESTIONER_CASE_ID=cretskens
ENABLED_BACKENDS=rag

# Minimaal niveau voor logging (trace|debug|info|warn|error).
LOG_LEVEL=info

# Audit (logging en API)
AUDIT_DB_URL=postgres://audit:audit@audit-db:5432/audit
AUDIT_LOGGING_ENABLED=true
AUDIT_DEBUG_LOGGING=false
AUDIT_API_URL=http://audit-api:8000
AUDIT_LOG_TIMEOUT_MS=250
AUDIT_PROFILE=cretskens
AUDIT_TIMEOUT_SECONDS=0.25

# Azure OpenAI - basis (snelle/light modellen)
AZURE_OPENAI_ENDPOINT=https://tai-for-gpt-4.openai.azure.com/
BASE_AZURE_OPENAI_API_VERSION=2024-02-15-preview
BASE_AZURE_OPENAI_MODEL_VERSION=gpt4o-mini

# Azure OpenAI - advanced (diepere/grotere modellen)
ADVANCED_AZURE_OPENAI_API_VERSION=2024-12-01-preview
ADVANCED_AZURE_OPENAI_MODEL=gpt-5-chat
ADVANCED_AZURE_OPENAI_TEMPERATURE=0.01
ADVANCED_AZURE_OPENAI_TIMEOUT_SECONDS=15
ADVANCED_AZURE_OPENAI_MAX_TOKENS=450

# Questioner profile config
DOMAIN_PROFILE_PATH=profiles/cretskens/domain_profile.yml
WINE_ADVISOR_CANDIDATE_LIMIT=40
WINE_ADVISOR_MAX_INPUT_CHARS=600
WINE_ADVISOR_MAX_STATE_BYTES=12000
WINE_ADVISOR_MAX_WORKING_CONTEXT_CHARS=2200
WINE_ADVISOR_MAX_HISTORY_ITEMS=8
WINE_ADVISOR_MAX_HISTORY_ITEM_CHARS=240

# Frontend toggle zichtbaar/instelbaar
ACTIVE_CLIENT_DEBUG_TOGGLE_ENABLED=false
ACTIVE_CLIENT_DEBUG_DEFAULT_ENABLED=false

# Backend debug traces toelaten
WINE_ADVISOR_DEBUG_ENABLED=false

# Chat proxy abuse-guards
MAX_CHAT_INPUT_CHARS=600
MAX_CHAT_STATE_BYTES=16000
MAX_CHAT_HISTORY_ITEMS=12
MAX_CHAT_HISTORY_ENTRY_CHARS=320
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=120
RATE_LIMIT_BLOCK_SECONDS=300
SESSION_IDLE_TIMEOUT_SECONDS=900
