# =============================================================================
# Case: auva
# =============================================================================
ACTIVE_CLIENT_ID=auva
ACTIVE_CLIENT_DISPLAY_NAME=AUVA
ACTIVE_CLIENT_COLLECTION_ID=auva
ACTIVE_CLIENT_PRIMARY_COLOR=#009fe4
ACTIVE_CLIENT_LOGO_URL=/branding/auva/logo.png
ACTIVE_CLIENT_BACKGROUND_IMAGE_URL=/branding/auva/background.jpg
ACTIVE_CLIENT_WELCOME_MESSAGE="Welkom bij AUVA! We helpen je graag verder met al je vragen over printers, laptops, smartphones en andere IT-benodigdheden. Waarnaar ben je vandaag op zoek?"

# Backendprofiel/stack die Pixie moet aanspreken (bijv. informer).
PIXIE_BACKEND_TARGET=informer
ENABLED_BACKENDS=rag

# Minimaal niveau voor logging (trace|debug|info|warn|error).
LOG_LEVEL=info

# Audit (logging en API)
AUDIT_DB_URL=postgres://audit:audit@audit-db:5432/audit
AUDIT_LOGGING_ENABLED=true
AUDIT_DEBUG_LOGGING=false
AUDIT_API_URL=http://audit-api:8000
AUDIT_PROFILE=auva
AUDIT_TIMEOUT_SECONDS=0.25
AUDIT_LOG_TIMEOUT_MS=250

# Azure OpenAI - basis (snelle/light modellen)
AZURE_OPENAI_ENDPOINT=https://tai-for-gpt-4.openai.azure.com/
BASE_AZURE_OPENAI_API_VERSION=2024-02-15-preview
BASE_AZURE_OPENAI_MODEL_VERSION=gpt4o-mini

# Azure OpenAI - advanced (diepere/grotere modellen)
ADVANCED_AZURE_OPENAI_API_VERSION=2024-12-01-preview
ADVANCED_AZURE_OPENAI_MODEL=gpt-5-chat
ADVANCED_AZURE_OPENAI_TEMPERATURE=0.01

# RAG-instellingen
RAG_COLLECTION_NAME=pxl
RAG_EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Tabular (gestructureerde antwoorden)
TABULAR_COLLECTION=auva
TABULAR_RESULT_THRESHOLD=5
TABULAR_MAX_REFINE_QUESTIONS=3

# Prompts (optioneel, alleen nodig bij questioner)
# SYSTEM_PROMPT_PATH=/case/prompts/system_prompt.txt
# SUMMARIZER_PROMPT_PATH=/case/prompts/conversation_summarizer.txt
# QUESTIONNAIRE_TEMPLATE_PATH=/case/prompts/questionnaire_template.txt
# QUESTIONNAIRE_NOTULIST_PROMPT_PATH=/case/prompts/questionnaire_notulist.txt
