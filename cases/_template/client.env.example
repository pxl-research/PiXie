# =============================================================================
# Case: <CLIENT_ID>
# =============================================================================
# Keep ACTIVE_CLIENT_ID in sync with the case folder name.
ACTIVE_CLIENT_ID=<CLIENT_ID>
ACTIVE_CLIENT_DISPLAY_NAME=<DISPLAY_NAME>
ACTIVE_CLIENT_COLLECTION_ID=<CLIENT_ID>
ACTIVE_CLIENT_PRIMARY_COLOR=#000000
ACTIVE_CLIENT_LOGO_URL=/branding/<CLIENT_ID>/logo.png
ACTIVE_CLIENT_LOGO_NO_TEXT_URL=/branding/<CLIENT_ID>/logo_no_text.png
ACTIVE_CLIENT_BACKGROUND_IMAGE_URL=/branding/<CLIENT_ID>/background.png
ACTIVE_CLIENT_WELCOME_MESSAGE="Welkom! Hoe kan ik je vandaag helpen?\n"
ACTIVE_CLIENT_CHAT_HEADER_TITLE=Assistant

# Backendprofiel/stack die Pixie moet aanspreken (bijv. informer, recommender, questioner).
PIXIE_BACKEND_TARGET=questioner
ENABLED_BACKENDS=rag

# Minimaal niveau voor logging (trace|debug|info|warn|error).
LOG_LEVEL=info

# Audit (logging en API)
AUDIT_DB_URL=postgres://audit:audit@audit-db:5432/audit
AUDIT_LOGGING_ENABLED=true
AUDIT_DEBUG_LOGGING=false
AUDIT_API_URL=http://audit-api:8000
AUDIT_PROFILE=<CLIENT_ID>
AUDIT_TIMEOUT_SECONDS=0.25
AUDIT_LOG_TIMEOUT_MS=250

# Prompts (resolved inside /case)
SYSTEM_PROMPT_PATH=/case/prompts/system_prompt.txt
SUMMARIZER_PROMPT_PATH=/case/prompts/conversation_summarizer.txt
QUESTIONNAIRE_TEMPLATE_PATH=/case/prompts/questionnaire_template.txt
QUESTIONNAIRE_NOTULIST_PROMPT_PATH=/case/prompts/questionnaire_notulist.txt

# Azure OpenAI - basis (snelle/light modellen)
AZURE_OPENAI_ENDPOINT=<AZURE_OPENAI_ENDPOINT>
BASE_AZURE_OPENAI_API_VERSION=2024-02-15-preview
BASE_AZURE_OPENAI_MODEL_VERSION=gpt4o-mini

# Azure OpenAI - advanced (diepere/grotere modellen)
ADVANCED_AZURE_OPENAI_API_VERSION=2024-12-01-preview
ADVANCED_AZURE_OPENAI_MODEL=gpt-5-chat
ADVANCED_AZURE_OPENAI_TEMPERATURE=0.01
