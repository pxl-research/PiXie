# Rename this file to settings.env!

# Azure Document Loader
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=your-endpoint-here
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-api-key-here

# BGE M3 embeddings
EMBEDDINGS_MODEL_NAME="BAAI/bge-m3"

# Qdrant vector store
QDRANT_HOST="vectorstore"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="pixie" 


# Azure Open AI LLM
AZURE_OPENAI_ENDPOINT=your-endpoint-here
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MODEL_VERSION=gpt4o-mini

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=your-connection-string-here
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name-here
AZURE_CONTAINER_NAME=your-container-name-here